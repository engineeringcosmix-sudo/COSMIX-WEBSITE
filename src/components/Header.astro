---
import { site } from "../lib/catalog";
const path = Astro.url.pathname;
const sales = site.phones.find((phone) => phone.whatsapp);
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/products", label: "Products" },
  { href: "/contracting", label: "Contracting" },
  { href: "/installation", label: "Installation" },
  { href: "/services", label: "Services" },
  { href: "/projects", label: "Projects" },
  { href: "/clients", label: "Clients" },
  { href: "/contact", label: "Contact" },
];
const current = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
---

<div class="bg-navy text-white">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-5 gap-y-1 py-2 text-[0.78rem] font-semibold tracking-wide">
    <p>Karachi | Lahore | Islamabad</p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <span>Mon – Sat, 9:00 AM – 8:00 PM</span>
      <a href={`tel:${sales?.tel}`}>Sales {sales?.display}</a>
      <a href={`mailto:${site.emails[0]}`}>{site.emails[0]}</a>
    </p>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-white/10 bg-navy-2 text-white">
  <div class="wrap flex h-[4.25rem] items-center gap-3">
    <a href="/" class="mr-auto shrink-0 rounded-md bg-white px-2 py-1">
      <img src="/images/brand/cosmix-logo.webp" width="468" height="179" alt="Cosmix Engineering" class="h-9 w-auto" />
    </a>
    <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a class:list={["nav-link", current(link.href) && "is-current"]} href={link.href}>{link.label}</a>
        ))
      }
    </nav>
    <a class="btn hidden sm:inline-flex" href="/quote">Request a Quote</a>
    <button class="grid h-11 w-11 place-items-center border border-white/20 xl:hidden" type="button" data-menu-button aria-expanded="false" aria-controls="site-menu">
      <span class="sr-only">Open menu</span>
      <span aria-hidden="true">☰</span>
    </button>
  </div>
  <nav id="site-menu" class="hidden border-t border-white/10 bg-navy px-4 py-4 xl:hidden" data-menu>
    <div class="grid gap-2">
      {links.map((link) => <a class="py-1 font-semibold" href={link.href}>{link.label}</a>)}
      <a class="btn mt-2 w-fit" href="/quote">Request a Quote</a>
    </div>
  </nav>
</header>

<style>
  .nav-link {
    border-radius: 0;
    padding: 0.45rem 0.55rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: white;
    text-decoration: none;
  }
  .nav-link.is-current,
  .nav-link:hover {
    color: var(--color-copper-bright);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-menu]");
  button?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    button.setAttribute("aria-expanded", String(open));
    const label = button.querySelector(".sr-only");
    if (label) label.textContent = open ? "Close menu" : "Open menu";
  });
</script>
