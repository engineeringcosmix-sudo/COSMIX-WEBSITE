---
import { brandInfo, brands, categoriesFor, companyImages, services } from "../lib/catalog";
const path = Astro.url.pathname;
const aux = categoriesFor("aux");
const clivet = categoriesFor("clivet");
---

<div class="bg-navy text-white text-sm">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-2">
    <p>Karachi · Lahore · Mon–Sat 9:00am–8:00pm</p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <a href="tel:+923333152331">Sales: +92 333 3152331</a>
      <a href="/complaint">Register a Complaint</a>
      <a href="mailto:info@cosmixengineering.com">info@cosmixengineering.com</a>
    </p>
  </div>
</div>
<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="wrap flex h-16 items-center gap-3">
    <a href="/" class="mr-auto shrink-0">
      <img
        src={companyImages.logo.src}
        width={companyImages.logo.width}
        height={companyImages.logo.height}
        alt={companyImages.logo.alt}
        class="h-10 w-auto"
      />
    </a>
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <a class:list={["nav-link", path === "/about" && "is-current"]} href="/about">About</a>
      <div class="group relative">
        <a class:list={["nav-link", path.startsWith("/brands/aux") && "is-current"]} href="/brands/aux" aria-haspopup="true">AUX</a>
        <div class="menu-panel">
          <p class="eyebrow text-aux">AUX</p>
          <a href="/brands/aux">All AUX products</a>
          {aux.map((category) => <a href={`/brands/aux?category=${category.id}`}>{category.name}</a>)}
        </div>
      </div>
      <div class="group relative">
        <a class:list={["nav-link", path.startsWith("/brands/clivet") && "is-current"]} href="/brands/clivet" aria-haspopup="true">CLIVET</a>
        <div class="menu-panel">
          <p class="eyebrow text-clivet">CLIVET</p>
          <a href="/brands/clivet">All CLIVET products</a>
          {clivet.map((category) => <a href={`/brands/clivet?category=${category.id}`}>{category.name}</a>)}
        </div>
      </div>
      <a class:list={["nav-link", path.startsWith("/brands/dehumidifiers") && "is-current"]} href="/brands/dehumidifiers">Dehumidifiers</a>
      <div class="group relative">
        <a class:list={["nav-link", path.startsWith("/services") && "is-current"]} href="/services" aria-haspopup="true">Services</a>
        <div class="menu-panel">
          <a href="/services">All services</a>
          {services.map((service) => <a href={`/services/${service.slug}`}>{service.name}</a>)}
        </div>
      </div>
      <a class:list={["nav-link", path === "/projects" && "is-current"]} href="/projects">Projects</a>
      <a class:list={["nav-link", path === "/events" && "is-current"]} href="/events">Events</a>
      <a class:list={["nav-link", path === "/contact" && "is-current"]} href="/contact">Contact</a>
    </nav>
    <a href="/search" class="grid h-10 w-10 place-items-center rounded-full border border-line" aria-label="Search products">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.5-3.5"></path>
      </svg>
    </a>
    <a href="/quote" class="btn hidden sm:inline-flex">Request a quote</a>
    <button type="button" class="grid h-10 w-10 place-items-center rounded-full border border-line lg:hidden" data-menu-button aria-expanded="false" aria-controls="site-menu">
      <span class="sr-only">Open menu</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
  <div id="site-menu" class="hidden border-t border-line bg-white lg:hidden" data-menu>
    <nav class="wrap grid gap-6 py-5" aria-label="Mobile">
      <a href="/about">About</a>
      <div>
        <p class="eyebrow text-aux">{brandInfo("aux").name}</p>
        <div class="mt-2 grid gap-2">
          <a href="/brands/aux">All AUX products</a>
          {aux.map((category) => <a href={`/brands/aux?category=${category.id}`}>{category.name}</a>)}
        </div>
      </div>
      <div>
        <p class="eyebrow text-clivet">{brandInfo("clivet").name}</p>
        <div class="mt-2 grid gap-2">
          <a href="/brands/clivet">All CLIVET products</a>
          {clivet.map((category) => <a href={`/brands/clivet?category=${category.id}`}>{category.name}</a>)}
        </div>
      </div>
      <div>
        <p class="eyebrow text-dehu">Industrial Dehumidifiers</p>
        <a class="mt-2 block" href="/brands/dehumidifiers">View the range</a>
      </div>
      <div>
        <p class="eyebrow">Services</p>
        <div class="mt-2 grid gap-2">
          {services.map((service) => <a href={`/services/${service.slug}`}>{service.name}</a>)}
        </div>
      </div>
      <a href="/projects">Projects</a>
      <a href="/events">Events</a>
      <a href="/contact">Contact</a>
      <a href="/complaint">Register a Complaint</a>
      <a href="/quote" class="btn w-fit">Request a quote</a>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    border-radius: 999px;
    padding: 0.35rem 0.5rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }
  .nav-link.is-current,
  .nav-link:hover {
    background: var(--color-paper);
  }
  .menu-panel {
    visibility: hidden;
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 20;
    display: grid;
    min-width: 16rem;
    gap: 0.35rem;
    padding: 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    background: white;
    box-shadow: 0 16px 40px rgba(16, 32, 51, 0.08);
  }
  .group:hover .menu-panel,
  .group:focus-within .menu-panel {
    visibility: visible;
  }
  .menu-panel a {
    border-radius: 0.6rem;
    padding: 0.35rem 0.45rem;
    text-decoration: none;
    color: var(--color-ink);
  }
  .menu-panel a:hover {
    background: var(--color-paper);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  const button = document.querySelector("[data-menu-button]");
  const menu = document.querySelector("[data-menu]");
  button?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    button.setAttribute("aria-expanded", String(open));
    const label = button.querySelector(".sr-only");
    if (label) label.textContent = open ? "Close menu" : "Open menu";
  });
</script>
