---
import { site } from "../lib/catalog";
const year = new Date().getFullYear();
const afterSales = site.phones.find((phone) => phone.label === "After-Sales");
const sales = site.phones.find((phone) => phone.whatsapp);
---

<footer class="mt-0 bg-navy text-white">
  <div class="border-b border-white/10">
    <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-2 py-4 text-sm text-white/70">
      <p class="eyebrow text-copper-bright">Cosmix Group</p>
      <span>Software</span>
      <span>Manufacturing</span>
      <span>Power</span>
      <span>Civil & Urban</span>
    </div>
  </div>
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="inline-flex rounded-md bg-white px-3 py-2">
        <img src="/images/brand/cosmix-logo.webp" width="468" height="179" alt="Cosmix Engineering" class="h-10 w-auto" />
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/75">
        HVACR and MEP supply, installation and after-sales support. Formerly Gafoor Engineering Services, since 1968.
      </p>
    </div>
    <div>
      <p class="eyebrow text-copper-bright">Products</p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><a href="/brands/aux">AUX</a></li>
        <li><a href="/brands/clivet">CLIVET</a></li>
        <li><a href="/brands/dehumidifiers">LUKO Dehumidifiers</a></li>
        <li><a href="/products">All Product Sections</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow text-copper-bright">Company</p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><a href="/about">About</a></li>
        <li><a href="/contracting">Contracting</a></li>
        <li><a href="/installation">Installation</a></li>
        <li><a href="/services">Service, O&M & After-Sales</a></li>
        <li><a href="/projects">Projects</a></li>
        <li><a href="/clients">Clients</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/complaint">Register a Complaint</a></li>
      </ul>
    </div>
    <div>
      <p class="eyebrow text-copper-bright">Head Office</p>
      <p class="mt-3 text-sm leading-relaxed text-white/80">
        Suite 1008, 10th Floor Cavish Crown, D.A.C.H.S, Main Shahrah-e-Faisal, Karachi
      </p>
      <ul class="mt-3 grid gap-2 text-sm">
        <li><a href={`tel:${sales?.tel}`}>Sales {sales?.display}</a></li>
        <li><a href={`tel:${afterSales?.tel}`}>After-Sales {afterSales?.display}</a></li>
        <li><a href="mailto:info@cosmixengineering.com">info@cosmixengineering.com</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="wrap py-4 text-sm text-white/60">© {year} Cosmix Engineering. All rights reserved.</p>
  </div>
</footer>
