---
import { brands, categoriesFor, companyImages, services, site } from "../lib/catalog";
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-navy text-white">
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="inline-flex rounded-xl bg-white px-3 py-2">
        <img src={companyImages.logo.src} width={companyImages.logo.width} height={companyImages.logo.height} alt="Cosmix Engineering" class="h-10 w-auto" />
      </div>
      <p class="mt-4 max-w-xs text-sm text-white/75">
        HVACR supply, installation and support from Karachi and Lahore.
      </p>
    </div>
    {
      brands.map((brand) => (
        <div>
          <p class="eyebrow text-copper-bright">{brand.name}</p>
          <ul class="mt-3 grid gap-2 text-sm">
            <li><a href={brand.href}>All {brand.name}</a></li>
            {categoriesFor(brand.id).slice(0, 6).map((category) => (
              <li><a href={`${brand.href}?category=${category.id}`}>{category.name}</a></li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-white/10">
    <div class="wrap grid gap-8 py-10 md:grid-cols-3">
      <div>
        <p class="eyebrow text-copper-bright">Services</p>
        <ul class="mt-3 grid gap-2 text-sm">
          {services.map((service) => <li><a href={`/services/${service.slug}`}>{service.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="eyebrow text-copper-bright">Company</p>
        <ul class="mt-3 grid gap-2 text-sm">
          <li><a href="/about">About</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/events">Events & achievements</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/search">Search products</a></li>
          <li><a href="/quote">Request a quote</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow text-copper-bright">Contact</p>
        <ul class="mt-3 grid gap-2 text-sm">
          <li><a href="mailto:info@cosmixengineering.com">info@cosmixengineering.com</a></li>
          <li><a href="mailto:sales@cosmixengineering.com">sales@cosmixengineering.com</a></li>
          <li><a href="tel:+923333152331">+92 333 3152331</a></li>
          <li><a href="tel:+923008248687">Head office +92 300 8248687</a></li>
          {site.socials.map((social) => (
            <li><a href={social.href} target="_blank" rel="noopener noreferrer">{social.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="wrap py-4 text-sm text-white/60">© {year} Cosmix Engineering (Pvt.) Ltd. All rights reserved.</p>
  </div>
</footer>
