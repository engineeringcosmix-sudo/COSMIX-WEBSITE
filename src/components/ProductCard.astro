---
import { productPath, searchText, type Product } from "../lib/catalog";
interface Props {
  product: Product;
}
const { product } = Astro.props;
const image = product.gallery[0];
const capacity = product.capacityBoxes[0];
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white"
  data-cat={product.categoryId}
  data-unit={product.capacity.unit ?? ""}
  data-min={product.capacity.min ?? ""}
  data-max={product.capacity.max ?? ""}
  data-q={searchText(product)}
  data-brand={product.brand}
>
  <a href={productPath(product)} class="flex h-full flex-col no-underline">
    <div class="grid aspect-[4/3] place-items-center bg-paper p-4">
      <img
        src={image.src}
        width={image.width}
        height={image.height}
        alt={image.alt}
        loading="lazy"
        decoding="async"
        class="max-h-full max-w-full object-contain"
      />
    </div>
    <div class="flex flex-1 flex-col p-4">
      <p class="eyebrow text-[var(--brand)]">{product.categoryName}</p>
      <h3 class="mt-2 font-serif text-2xl leading-tight">{product.name}</h3>
      <p class="mt-2 text-sm text-muted">{product.subtitle}</p>
      {capacity && <p class="mt-auto pt-4 text-sm font-semibold">{capacity.label}: {capacity.value}</p>}
    </div>
  </a>
</article>
