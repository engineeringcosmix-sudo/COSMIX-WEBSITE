---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="bg-navy text-white">
  <div class="wrap py-14 md:py-20">
    <p class="eyebrow text-copper-bright">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl font-serif text-4xl leading-tight md:text-6xl">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg text-white/80">{lede}</p>
    <slot />
  </div>
</section>
