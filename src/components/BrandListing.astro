---
import PageHero from "./PageHero.astro";
import ProductCard from "./ProductCard.astro";
import { categoriesFor, productsFor, type BrandInfo } from "../lib/catalog";
interface Props {
  brand: BrandInfo;
}
const { brand } = Astro.props;
const products = productsFor(brand.id);
const categories = categoriesFor(brand.id);
---

<div data-brand={brand.id}>
  <PageHero eyebrow="Product range" title={brand.name} lede={brand.summary}>
    <p class="mt-4 text-sm text-white/70">{brand.note} {products.length} series.</p>
    {brand.id === "dehumidifiers" && (
      <p class="mt-6 flex items-center gap-3 text-sm text-white/70">
        <span class="sr-only">Brand:</span>
        <img src="/images/dehumidifiers/luko-logo-white.webp" width="614" height="127" alt="LUKO" class="h-9 w-auto" loading="eager" decoding="async" />
      </p>
    )}
  </PageHero>
  <div class="wrap py-8" data-listing>
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 class="font-serif text-3xl">Find a product</h2>
        <p class="mt-1 text-sm text-muted" data-count>{products.length} products</p>
      </div>
      <label class="grid gap-1 text-sm font-semibold">
        Search within {brand.name}
        <input data-q class="min-h-11 rounded-full border border-line bg-white px-4 font-normal" type="search" placeholder="Name, model or capacity" />
      </label>
    </div>
    <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Categories">
      <button type="button" class="chip is-on" data-cat-btn data-cat="">All</button>
      {categories.map((category) => (
        <button type="button" class="chip" data-cat-btn data-cat={category.id}>{category.name} ({category.count})</button>
      ))}
    </div>
    <label class="mt-4 grid max-w-xs gap-1 text-sm font-semibold">
      Capacity
      <select data-capacity class="min-h-11 rounded-full border border-line bg-white px-4 font-normal">
        <option value="">Any capacity</option>
      </select>
    </label>
    <p class="mt-3 text-sm text-muted">Leave capacity on Any to include series that are sized for the project.</p>
    <p class="mt-6 hidden rounded-2xl border border-dashed border-line p-6 text-center" data-empty>No {brand.name} products match those filters.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</div>

<script>
  const BANDS = {
    kW: [
      ["Up to 50 kW", 0, 50],
      ["50–150 kW", 50, 150],
      ["150–400 kW", 150, 400],
      ["400 kW and above", 400, 100000],
    ],
    HP: [
      ["Up to 16 HP", 0, 16],
      ["16–36 HP", 16, 36],
      ["36 HP and above", 36, 1000],
    ],
    CFM: [
      ["Up to 500 CFM", 0, 500],
      ["500–1,000 CFM", 500, 1000],
      ["1,000 CFM and above", 1000, 100000],
    ],
    "kBtu/h": [
      ["Up to 24 kBtu/h", 0, 24],
      ["24–60 kBtu/h", 24, 60],
      ["60 kBtu/h and above", 60, 1000],
    ],
    "kg/h": [
      ["Up to 5 kg/h", 0, 5],
      ["5–20 kg/h", 5, 20],
      ["20 kg/h and above", 20, 1000],
    ],
    "L/day": [
      ["Up to 60 L/day", 0, 60],
      ["60–100 L/day", 60, 100],
      ["100 L/day and above", 100, 10000],
    ],
    "m³/h": [
      ["Up to 5,000 m³/h", 0, 5000],
      ["5,000–30,000 m³/h", 5000, 30000],
      ["30,000 m³/h and above", 30000, 10000000],
    ],
  };

  const root = document.querySelector("[data-listing]");
  if (root) {
    const cards = [...root.querySelectorAll("article")];
    const buttons = [...root.querySelectorAll("[data-cat-btn]")];
    const select = root.querySelector("[data-capacity]");
    const search = root.querySelector("[data-q]");
    const count = root.querySelector("[data-count]");
    const empty = root.querySelector("[data-empty]");
    const params = new URLSearchParams(location.search);
    let category = params.get("category") || "";

    const rebuild = () => {
      if (!(select instanceof HTMLSelectElement)) return;
      const previous = select.value;
      const units = [...new Set(cards.filter((card) => !category || card.dataset.cat === category).map((card) => card.dataset.unit).filter(Boolean))];
      select.innerHTML = '<option value="">Any capacity</option>';
      for (const unit of units) {
        for (const band of BANDS[unit] || []) {
          const option = document.createElement("option");
          option.value = `${unit}|${band[1]}|${band[2]}`;
          option.textContent = String(band[0]);
          select.appendChild(option);
        }
      }
      if ([...select.options].some((option) => option.value === previous)) select.value = previous;
    };

    const apply = () => {
      const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : "";
      const band = select instanceof HTMLSelectElement ? select.value : "";
      let visible = 0;
      for (const card of cards) {
        let show = !category || card.dataset.cat === category;
        if (show && query) show = (card.dataset.q || "").includes(query);
        if (show && band) {
          const [unit, min, max] = band.split("|");
          const cardMin = Number(card.dataset.min);
          const cardMax = Number(card.dataset.max);
          show = card.dataset.unit === unit && cardMax >= Number(min) && cardMin <= Number(max);
        }
        card.classList.toggle("hidden", !show);
        if (show) visible += 1;
      }
      if (count) count.textContent = `${visible} of ${cards.length} products`;
      empty?.classList.toggle("hidden", visible !== 0);
    };

    buttons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const selected = button.dataset.cat === category;
      button.classList.toggle("is-on", selected);
      button.setAttribute("aria-pressed", String(selected));
      button.addEventListener("click", () => {
        category = button.dataset.cat || "";
        buttons.forEach((item) => {
          const on = item === button;
          item.classList.toggle("is-on", on);
          item.setAttribute("aria-pressed", String(on));
        });
        rebuild();
        apply();
      });
    });
    select?.addEventListener("change", apply);
    search?.addEventListener("input", apply);
    rebuild();
    apply();
  }
</script>
