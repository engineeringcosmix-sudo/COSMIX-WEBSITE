---
import Base from "../layouts/Base.astro";
import { brands, productsFor, services } from "../lib/catalog";
import projects from "../data/projects.json";
import { organizationLd } from "../lib/seo";

const slides = [
  { file: "rooftop-plant", caption: "Rooftop plant and chilled-water systems" },
  { file: "site-build", caption: "Turn-key installation on the building" },
  { file: "outdoor-units", caption: "Outdoor equipment in service" },
];
const featured = [
  productsFor("aux").find((item) => item.slug === "arv-7-series"),
  productsFor("clivet").find((item) => item.slug === "spinchiller4"),
  productsFor("dehumidifiers").find((item) => item.slug === "luko-desiccant-fd-d210k-d320k"),
].filter((item) => Boolean(item));
const clients = [
  ["01", "Hasham Towel"],
  ["02", "Samaa"],
  ["05", "Al Farooq Steel Industries"],
  ["09", "USAID"],
  ["11", "Amson"],
  ["15", "QEL"],
  ["16", "Hassan Group"],
  ["17", "Alkaram"],
  ["19", "Silver Textile Factory"],
  ["22", "HBL"],
  ["23", "Novatex"],
];
const loop = [...clients, ...clients];
---

<Base
  title="Cosmix Engineering"
  description="HVACR and MEP leadership since 1968. Cosmix Engineering, formerly Gafoor Engineering Services, supplies, installs and supports systems from Peshawar to Karachi."
  path="/"
  extraLd={[organizationLd()]}
>
  <section class="hero" data-hero>
    {
      slides.map((slide, index) => (
        <div class:list={["hero-slide", index === 0 && "is-on"]} data-slide>
          <video autoplay={index === 0} muted loop playsinline poster={`/videos/posters/${slide.file}.jpg`}>
            <source src={`/videos/hero/${slide.file}.webm`} type="video/webm" />
            <source src={`/videos/hero/${slide.file}.mp4`} type="video/mp4" />
          </video>
        </div>
      ))
    }
    <div class="hero-shade"></div>
    <div class="hero-copy wrap">
      <p class="eyebrow text-copper-bright">HVACR and MEP · Since 1968</p>
      <h1 class="mt-4 max-w-4xl font-serif text-5xl font-bold leading-[1.02] md:text-7xl">HVACR Leadership Since 1968</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/85">
        Formerly Gafoor Engineering Services. More than 200 projects and 31 HVAC and electro-mechanical engineers, from Peshawar to Karachi.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn" href="/products">View Products</a>
        <a class="btn-ghost border-white text-white" href="/projects">See Projects</a>
      </div>
      <div class="stat-row max-w-4xl">
        <div class="stat"><b data-count="1968">1968</b><span class="text-sm text-white/75">Leadership since</span></div>
        <div class="stat"><b data-count="200" data-suffix="+">200+</b><span class="text-sm text-white/75">Projects</span></div>
        <div class="stat"><b data-count="31" data-suffix="+">31+</b><span class="text-sm text-white/75">HVAC engineers</span></div>
        <div class="stat"><b>PK</b><span class="text-sm text-white/75">Peshawar to Karachi</span></div>
      </div>
    </div>
  </section>

  <section class="bg-[#0c1e33] text-white">
    <div class="wrap grid md:grid-cols-3">
      {
        brands.map((brand) => (
          <a class="border-t border-white/10 px-1 py-6 no-underline md:border-t-0 md:border-l md:px-6 first:md:border-l-0" href={brand.href}>
            <p class="eyebrow text-copper-bright">{brand.id === "dehumidifiers" ? "LUKO" : brand.name}</p>
            <p class="mt-2 font-serif text-2xl text-white">{brand.id === "dehumidifiers" ? "Dehumidifiers" : brand.name}</p>
            <p class="mt-2 text-sm text-white/70">{brand.note}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap" data-slider>
      <div class="slider-head">
        <div>
          <p class="eyebrow text-copper">Services</p>
          <h2 class="mt-2 font-serif text-4xl">Service, O&M and After-Sales</h2>
        </div>
        <div class="flex gap-2">
          <button class="icon-btn" type="button" data-prev aria-label="Previous service">←</button>
          <button class="icon-btn" type="button" data-next aria-label="Next service">→</button>
        </div>
      </div>
      <div class="slider-track" data-track>
        {
          services.map((service) => (
            <a class="panel no-underline" href={`/services/${service.slug}`}>
              <h3 class="font-serif text-2xl">{service.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{service.summary}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-navy text-white" data-reveal>
    <div class="wrap" data-slider>
      <div class="slider-head">
        <div>
          <p class="eyebrow text-copper-bright">Products</p>
          <h2 class="mt-2 font-serif text-4xl">Three Ranges, Kept Separate</h2>
        </div>
        <div class="flex gap-2">
          <button class="icon-btn border-white/30 bg-transparent text-white" type="button" data-prev aria-label="Previous product">←</button>
          <button class="icon-btn border-white/30 bg-transparent text-white" type="button" data-next aria-label="Next product">→</button>
        </div>
      </div>
      <div class="slider-track" data-track>
        {
          featured.map((product) => product && (
            <a class="panel bg-white text-ink no-underline" href={`/brands/${product.brand}/${product.slug}`}>
              <img src={product.gallery[0].src} alt={product.gallery[0].alt} class="h-44 w-full object-contain" />
              <p class="mt-4 eyebrow text-copper">{product.brand === "dehumidifiers" ? "LUKO" : product.brand === "aux" ? "AUX" : "CLIVET"}</p>
              <h3 class="mt-1 font-serif text-2xl">{product.name}</h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" data-reveal>
    <div class="wrap" data-slider>
      <div class="slider-head">
        <div>
          <p class="eyebrow text-copper">Projects</p>
          <h2 class="mt-2 font-serif text-4xl">Work Across Pakistan</h2>
        </div>
        <div class="flex gap-2">
          <button class="icon-btn" type="button" data-prev aria-label="Previous project">←</button>
          <button class="icon-btn" type="button" data-next aria-label="Next project">→</button>
        </div>
      </div>
      <div class="slider-track" data-track>
        {
          projects.slice(0, 12).map((project) => (
            <article class="panel">
              <p class="eyebrow text-copper">{project.city}</p>
              <h3 class="mt-2 font-serif text-2xl">{project.name}</h3>
              <p class="mt-3 text-sm text-muted">{project.detail}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-5"><a class="font-semibold" href="/projects">All Projects</a></p>
    </div>
  </section>

  <section class="section bg-paper" data-reveal>
    <div class="wrap">
      <p class="eyebrow text-copper">Clients</p>
      <h2 class="mt-2 font-serif text-4xl">Clientele</h2>
    </div>
    <div class="marquee mt-8">
      <div class="marquee-track">
        {
          loop.map(([file, name]) => (
            <div class="logo-card">
              <img src={`/images/clients/logo-${file}.png`} alt={name} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
