---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import projects from "../data/projects.json";
---

<Base
  title="Projects"
  description="HVACR and MEP projects by Cosmix Engineering, from Karachi and Lahore to Quetta, Islamabad, Faisalabad and Shanghai."
  path="/projects"
>
  <PageHero
    eyebrow="Projects"
    title="Projects From the Company Record"
    lede="Capacities and cities as stated in the company profile, including chilled water, DX and VRF work."
  />
  <section class="section wrap" data-slider data-reveal>
    <div class="slider-head">
      <h2 class="font-serif text-3xl">Selected Work</h2>
      <div class="flex gap-2">
        <button class="icon-btn" type="button" data-prev aria-label="Previous">←</button>
        <button class="icon-btn" type="button" data-next aria-label="Next">→</button>
      </div>
    </div>
    <div class="slider-track" data-track>
      {
        projects.map((project) => (
          <article class="panel">
            <p class="eyebrow text-copper">{project.city}</p>
            <h2 class="mt-2 font-serif text-2xl">{project.name}</h2>
            <p class="mt-3 text-sm text-muted">{project.detail}</p>
          </article>
        ))
      }
    </div>
  </section>
</Base>
