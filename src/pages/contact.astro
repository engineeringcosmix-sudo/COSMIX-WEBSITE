---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { site } from "../lib/catalog";
---

<Base
  title="Contact"
  description="Contact Cosmix Engineering in Karachi at C-25, Block 4, Gulshan-e-Iqbal, or the Lahore office at 516-E Tajpura Scheme, Ghaziabad. Monday to Saturday, 9am to 8pm."
  path="/contact"
>
  <PageHero
    eyebrow="Contact"
    title="Karachi head office and Lahore."
    lede={`${site.hours}. Write to info@ or sales@cosmixengineering.com, or send a quotation request.`}
  />
  <section class="wrap grid gap-10 py-14 lg:grid-cols-[0.85fr_1.15fr]">
    <div class="grid gap-4">
      {
        site.offices.map((office) => (
          <article class="rounded-3xl border border-line bg-white p-5">
            <h2 class="font-serif text-2xl">{office.name}</h2>
            <p class="mt-2 text-muted">{office.lines.join(", ")}</p>
            <a class="mt-3 inline-block font-semibold underline-offset-2 hover:underline" href={office.maps} target="_blank" rel="noopener noreferrer">Open in Google Maps</a>
          </article>
        ))
      }
      <article class="rounded-3xl border border-line bg-paper p-5">
        <h2 class="font-serif text-2xl">Phone and email</h2>
        <ul class="mt-3 grid gap-2">
          {site.phones.map((phone) => (
            <li><a class="font-semibold" href={`tel:${phone.tel}`}>{phone.label}: {phone.display}</a></li>
          ))}
          {site.emails.map((email) => (
            <li><a class="font-semibold" href={`mailto:${email}`}>{email}</a></li>
          ))}
        </ul>
        <p class="mt-3 text-sm text-muted">{site.hours}</p>
        <ul class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
          {site.socials.map((social) => (
            <li><a href={social.href} target="_blank" rel="noopener noreferrer">{social.name}</a></li>
          ))}
        </ul>
      </article>
    </div>
    <div class="rounded-3xl border border-line bg-white p-5 md:p-7">
      <h2 class="font-serif text-3xl">Send a message</h2>
      <p class="mt-2 mb-5 text-muted">The product field stays blank unless you arrived from a product page.</p>
      <QuoteForm />
    </div>
  </section>
</Base>
