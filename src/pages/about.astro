---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { affiliations, events, partners, site } from "../lib/catalog";
const aboutPhotos = events.filter((event) => event.about);
const ceo = site.people[0];
const sales = site.people[1];
---

<Base
  title="About"
  description="Cosmix Engineering (Pvt.) Ltd. is a Karachi HVACR company led by CEO Zeeshan Ashraf, with marketing and sales directed by Irtaza Sarwar."
  path="/about"
>
  <PageHero
    eyebrow="About the company"
    title="A Karachi HVACR company with three separate catalogues."
    lede="Cosmix Engineering, formerly Gafoor Engineering Services, works from Gulshan-e-Iqbal in Karachi and from Lahore. AUX equipment, CLIVET equipment and dehumidifiers are handled as separate lines of business."
  />
  <section class="wrap grid gap-10 py-14 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <h2 class="font-serif text-3xl">What the company does</h2>
      <div class="mt-4 grid gap-4 text-lg leading-relaxed text-muted">
        <p>The work runs from equipment supply through installation, testing, commissioning and after-sales support. The published portfolio names campuses, high-rises, hotels, workplaces and a mall, in cities from Islamabad and Karachi to Multan, Quetta, Lahore and a pavilion in Shanghai.</p>
        <p>The company describes its engineers and project staff as covering the major cities of Pakistan. Headcount, years in business and project totals are not printed here: the previous website gave conflicting figures, and those are waiting on the owner.</p>
        <p>Zeeshan Ashraf is Chief Executive Officer. Irtaza Sarwar is Director Marketing & Sales.</p>
      </div>
    </div>
    <aside class="rounded-3xl border border-line bg-paper p-6">
      <p class="eyebrow text-copper">Marketing & sales</p>
      <h2 class="mt-2 font-serif text-3xl">{sales.name}</h2>
      <p class="text-muted">{sales.role}</p>
      <p class="mt-4">Need help with a quotation? Contact Irtaza Sarwar.</p>
      <p class="mt-3 font-semibold"><a href={`tel:${sales.tel}`}>{sales.phone}</a></p>
      <p class="font-semibold"><a href={`mailto:${sales.email}`}>{sales.email}</a></p>
    </aside>
  </section>

  <section class="bg-paper py-14">
    <div class="wrap">
      <p class="eyebrow text-copper">Words from our leader</p>
      <h2 class="mt-2 font-serif text-4xl">{ceo.name}</h2>
      <p class="text-muted">{ceo.role}</p>
      <blockquote class="mt-6 max-w-3xl font-serif text-2xl leading-snug md:text-3xl">“{ceo.quote}”</blockquote>
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {
          aboutPhotos.map((photo) => (
            <figure class="overflow-hidden rounded-2xl border border-line bg-white">
              <img src={photo.src} width={photo.width} height={photo.height} alt={photo.alt} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
              <figcaption class="p-3 text-sm text-muted">{photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap py-14">
    <h2 class="font-serif text-3xl">Partners</h2>
    <ul class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
      {partners.map((partner) => (
        <li class="grid h-28 place-items-center rounded-2xl border border-line bg-white p-4">
          <img src={partner.src} width={partner.width} height={partner.height} alt={partner.alt} loading="lazy" decoding="async" class="max-h-16 w-auto object-contain" />
        </li>
      ))}
    </ul>
    <h2 class="mt-10 font-serif text-3xl">Affiliations</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {affiliations.map((item) => (
        <li class="grid h-28 place-items-center rounded-2xl border border-line bg-white p-4">
          <img src={item.src} width={item.width} height={item.height} alt={item.alt} loading="lazy" decoding="async" class="max-h-16 w-auto object-contain" />
        </li>
      ))}
    </ul>
  </section>
</Base>
