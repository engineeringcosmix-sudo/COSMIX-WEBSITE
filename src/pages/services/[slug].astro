---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { services, site } from "../../lib/catalog";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const afterSales = site.phones.find((phone) => phone.label === "After-Sales");
---

<Base title={service.name} description={service.summary} path={`/services/${service.slug}`}>
  <PageHero eyebrow="Services" title={service.name} lede={service.summary} />
  <article class="wrap grid gap-8 py-12 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <p class="text-lg leading-relaxed text-muted">{service.intro}</p>
      <h2 class="mt-8 font-serif text-3xl">What this covers</h2>
      <ul class="mt-4 grid gap-3">
        {service.points.map((point) => <li class="rounded-2xl border border-line bg-white px-4 py-3">{point}</li>)}
      </ul>
      <p class="mt-6 text-muted">{service.applies}</p>
    </div>
    <aside class="h-fit rounded-3xl bg-navy p-6 text-white">
      <h2 class="font-serif text-2xl">Ask for this service</h2>
      <p class="mt-2 text-sm text-white/75">Tell us the building, the city and what you need done.</p>
      {service.slug === "operation-maintenance" && afterSales && (
        <p class="mt-4 text-sm">
          After-Sales: <a class="font-semibold" href={`tel:${afterSales.tel}`}>{afterSales.display}</a>
        </p>
      )}
      <a class="btn mt-5" href={`/quote?interest=SERVICES&product=${encodeURIComponent(service.name)}`}>Request a quote</a>
      {service.slug === "operation-maintenance" && (
        <a class="mt-3 block text-sm font-semibold underline-offset-2 hover:underline" href="/complaint">Register a Complaint</a>
      )}
    </aside>
  </article>
</Base>
