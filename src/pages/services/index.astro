---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { services } from "../../lib/catalog";
---

<Base
  title="Services"
  description="HVACR services from Cosmix Engineering: supply and installation, operation and maintenance, electro-mechanical work, testing and balancing, energy audit and ducting."
  path="/services"
>
  <PageHero
    eyebrow="Services"
    title="The work around the equipment."
    lede="Supply, installation, maintenance and the engineering that keeps a finished system running."
  />
  <section class="wrap grid gap-4 py-12 md:grid-cols-2">
    {
      services.map((service) => (
        <a href={`/services/${service.slug}`} class="rounded-3xl border border-line bg-white p-6 no-underline hover:border-copper">
          <h2 class="font-serif text-3xl">{service.name}</h2>
          <p class="mt-3 text-muted">{service.summary}</p>
        </a>
      ))
    }
  </section>
</Base>
