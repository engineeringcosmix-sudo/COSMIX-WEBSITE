---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { services } from "../../lib/catalog";
---

<Base
  title="Services"
  description="Service, operation and maintenance from Cosmix Engineering, including fixed-rate contracts, emergency call-out and 24-hour cover. After-sales 0343 8248687."
  path="/services"
>
  <PageHero
    eyebrow="Services"
    title="Service, O&M and After-Sales"
    lede="Fixed-rate contracts, emergency call-out, scheduled inspection and 24-hour cover. After-sales is 0343 8248687."
  />
  <section class="wrap grid gap-4 py-12 md:grid-cols-2">
    {
      services.map((service) => (
        <a href={`/services/${service.slug}`} class="rounded-3xl border border-line bg-white p-6 no-underline hover:border-copper">
          <h2 class="font-serif text-3xl">{service.name}</h2>
          <p class="mt-3 text-muted">{service.summary}</p>
        </a>
      ))
    }
  </section>
</Base>
