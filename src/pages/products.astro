---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { brands } from "../lib/catalog";
---

<Base
  title="Catalogues"
  description="AUX air conditioning, CLIVET chillers and heat pumps, and industrial dehumidifiers from Cosmix Engineering."
  path="/products"
>
  <PageHero
    eyebrow="Our brands"
    title="Explore our product ranges."
    lede="AUX air conditioning, CLIVET plant, and industrial dehumidifiers."
  />
  <section class="wrap grid gap-4 py-12 lg:grid-cols-3">
    {
      brands.map((brand) => (
        <article data-brand={brand.id} class="brand-rule rounded-3xl border border-line bg-white p-6">
          <h2 class="font-serif text-3xl">{brand.name}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{brand.summary}</p>
          <a class="btn mt-5" href={brand.href}>Open {brand.name}</a>
        </article>
      ))
    }
  </section>
</Base>
