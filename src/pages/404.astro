---
import Base from "../layouts/Base.astro";
import { brands } from "../lib/catalog";
---

<Base title="Page not found" description="That page is not on the Cosmix Engineering site." path="/404">
  <section class="wrap py-20">
    <p class="eyebrow text-copper">404</p>
    <h1 class="mt-3 font-serif text-5xl">This page is not on the site.</h1>
    <p class="mt-4 max-w-xl text-muted">Browse our product ranges, or search.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      {brands.map((brand) => <a class="btn" href={brand.href}>{brand.name}</a>)}
      <a class="btn-ghost" href="/search">Search</a>
    </div>
  </section>
</Base>
