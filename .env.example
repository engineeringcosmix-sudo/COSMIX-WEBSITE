# Server only. Never prefix these with PUBLIC_. They must not be readable by browser JavaScript.
# Hub origin only, for example https://hub.example.com
HUB_BASE_URL=
HUB_API_KEY=
HUB_HMAC_SECRET=

# Cloudflare Turnstile site key. This value is public and is rendered in the page.
# The Turnstile secret stays on the Hub host.
PUBLIC_TURNSTILE_SITE_KEY=
