# Optional. HTTPS endpoint that accepts a JSON POST from the quote form.
# Leave empty to open a prefilled email to sales@cosmixengineering.com instead.
PUBLIC_INQUIRY_ENDPOINT=

# Web3Forms access key for after-sales complaints sent to info@cosmixengineering.com.
# Create one at https://web3forms.com. Leave empty until the owner has a key.
PUBLIC_WEB3FORMS_ACCESS_KEY=
